@baseUrl = http://127.0.0.1:8000
@queueName = orders
@exampleQueue = hello-world

### Hello World: create a queue
# @name createHelloWorldQueue
POST {{baseUrl}}/queues
Content-Type: application/json

{
  "queue_name": "{{exampleQueue}}"
}

### Get queue details
GET {{baseUrl}}/queues/{{exampleQueue}}

### Change the queue's default visibility timeout
PATCH {{baseUrl}}/queues/{{exampleQueue}}
Content-Type: application/json

{
  "visibility_timeout": 45
}

### Verify the updated queue details
GET {{baseUrl}}/queues/{{exampleQueue}}

### Send a Hello World message
# @name publishHelloWorldMessage
POST {{baseUrl}}/queues/{{exampleQueue}}/messages
Content-Type: application/json

{
  "body": "Hello, world!"
}

### Get the number of outstanding messages
GET {{baseUrl}}/queues/{{exampleQueue}}/length

### Receive the message
# @name receiveHelloWorldMessage
GET {{baseUrl}}/queues/{{exampleQueue}}/messages?max_messages=1&wait_time_seconds=5

### The count includes the received message while its visibility lease is active
GET {{baseUrl}}/queues/{{exampleQueue}}/length

### Delete the received message using its returned receipt handle
DELETE {{baseUrl}}/queues/{{exampleQueue}}/messages
Content-Type: application/json

{
  "receipt_handle": "{{receiveHelloWorldMessage.response.body.$[0].receipt_handle}}"
}

### Verify the message was removed from the queue
GET {{baseUrl}}/queues/{{exampleQueue}}/length

### Create a dead-letter queue before creating a source queue that references it
POST {{baseUrl}}/queues
Content-Type: application/json

{
  "queue_name": "orders-dlq"
}

### Create a queue
POST {{baseUrl}}/queues
Content-Type: application/json

{
  "queue_name": "{{queueName}}",
  "visibility_timeout": 30,
  "max_receive_count": 5,
  "dlq_name": "orders-dlq"
}

### Send a message
POST {{baseUrl}}/queues/{{queueName}}/messages
Content-Type: application/json

{
  "body": "{\"order_id\": 1024, \"amount\": 250.0}",
  "deduplication_id": "order-1024",
  "message_group_id": "orders"
}

### Receive messages using long polling
GET {{baseUrl}}/queues/{{queueName}}/messages?max_messages=10&wait_time_seconds=5

### Acknowledge a message; replace the handle with one from a receive response
DELETE {{baseUrl}}/queues/{{queueName}}/messages
Content-Type: application/json

{
  "receipt_handle": "replace-with-receipt-handle"
}